{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/web/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/css/(.*)",
      "destination": "/client/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/client/js/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/client/assets/$1"
    },
    {
      "source": "/partials/(.*)",
      "destination": "/client/partials/$1"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/client/dashboard/$1"
    },
    {
      "source": "/client/(.*)",
      "destination": "/client/$1"
    },
    {
      "source": "/connect-portal",
      "destination": "/client/connect-portal.html"
    },
    {
      "source": "/connect-portal.html",
      "destination": "/client/connect-portal.html"
    },
    {
      "source": "/login",
      "destination": "/client/login.html"
    },
    {
      "source": "/register",
      "destination": "/client/register.html"
    },
    {
      "source": "/creator",
      "destination": "/client/creator.html"
    },
    {
      "source": "/manifest.json",
      "destination": "/client/manifest.json"
    },
    {
      "source": "/service-worker.js",
      "destination": "/client/service-worker.js"
    },
    {
      "source": "/(.*)\\.html",
      "destination": "/client/$1.html"
    },
    {
      "source": "/(.*)",
      "destination": "/client/$1"
    }
  ]
}
