{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/**",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js",
      "headers": {
        "Content-Type": "application/json"
      }
    },
    {
      "src": "/web/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/css/(.*)",
      "dest": "/client/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/client/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/client/assets/$1"
    },
    {
      "src": "/partials/(.*)",
      "dest": "/client/partials/$1"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/client/dashboard/$1"
    },
    {
      "src": "/client/(.*)",
      "dest": "/client/$1"
    },
    {
      "src": "/connect-portal$",
      "dest": "/client/connect-portal.html"
    },
    {
      "src": "/connect-portal.html$",
      "dest": "/client/connect-portal.html"
    },
    {
      "src": "/login$",
      "dest": "/client/login.html"
    },
    {
      "src": "/register$",
      "dest": "/client/register.html"
    },
    {
      "src": "/creator$",
      "dest": "/client/creator.html"
    },
    {
      "src": "/manifest.json$",
      "dest": "/client/manifest.json"
    },
    {
      "src": "/service-worker.js$",
      "dest": "/client/service-worker.js"
    },
    {
      "src": "/(.*)\\.html$",
      "dest": "/client/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/client/$1"
    }
  ]
}
