# SOA Student Portal Scraper - Backend Environment Variables

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# In production, replace "*" with your frontend domain
# Example: https://your-frontend.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=*

# Playwright Configuration
# Path where Playwright browsers are installed
# For Render deployment: /opt/render/.cache/ms-playwright
# For Railway deployment: /root/.cache/ms-playwright
# For local development: leave empty (uses default)
PLAYWRIGHT_BROWSERS_PATH=

# Optional: Enable debug logging
DEBUG=false
