# SOA Student Portal Scraper - .gitignore

# Backend (Python)
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/*.so
backend/.Python
backend/venv/
backend/env/
backend/ENV/
backend/.env
backend/.venv
backend/pip-log.txt
backend/pip-delete-this-directory.txt
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/dist/
backend/build/
backend/*.egg-info/

# Frontend (Node.js)
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.DS_Store
frontend/.vscode/
frontend/.idea/

# Playwright
.cache/
ms-playwright/
playwright-report/
test-results/

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp
