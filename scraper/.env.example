# Flask Scraper Microservice Environment Configuration

# Flask Settings (FLASK_DEBUG should be False in production)
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_PORT=5001
SECRET_KEY=change-this-to-a-secure-random-string

# Portal Settings
# Primary portal URL - will try alternatives if this fails
PORTAL_URL=https://iterservices.soa.ac.in/StudentPortalSOA/

# Browser Settings
BROWSER_HEADLESS=True
BROWSER_TIMEOUT=30

# OpenRouter API Configuration (PRIMARY for CAPTCHA solving)
# OpenRouter provides access to multiple AI models through a single API
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=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

# Google Vision API (FALLBACK for CAPTCHA solving)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable Cloud Vision API in your GCP project
GOOGLE_VISION_API_KEY=your-google-vision-api-key-here

# Alternative: Service Account (for production deployments)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Rate Limiting
SCRAPE_RATE_LIMIT=10
SCRAPE_RATE_WINDOW=60

# Retry Settings
MAX_RETRIES=3
RETRY_DELAY=2

# CAPTCHA Settings
MAX_CAPTCHA_RETRIES=3
