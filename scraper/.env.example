# Flask Scraper Microservice Environment Configuration

# Flask Settings (FLASK_DEBUG should be False in production)
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_PORT=5001
SECRET_KEY=change-this-to-a-secure-random-string

# Portal Settings
PORTAL_URL=https://soaportals.com/StudentPortalSOA/#/

# Browser Settings
BROWSER_HEADLESS=True
BROWSER_TIMEOUT=30

# Google Vision API (for CAPTCHA solving)
# API Key is required for CAPTCHA OCR functionality
GOOGLE_VISION_API_KEY=AIzaSyB5aszVVX1UQuv0MEJOt0QumbnSa4x5z5A

# Alternative: Service Account (for production deployments)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Rate Limiting
SCRAPE_RATE_LIMIT=10
SCRAPE_RATE_WINDOW=60

# Retry Settings
MAX_RETRIES=3
RETRY_DELAY=2

# CAPTCHA Settings
MAX_CAPTCHA_RETRIES=3
