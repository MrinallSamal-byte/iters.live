# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Feature Flags
# TEMPORARILY DISABLED — DO NOT REMOVE
# Portal features are disabled by default. Set to 'true' to enable.
PORTAL_FEATURES_ENABLED=false

# Flask Scraper Microservice Configuration
FLASK_SCRAPER_URL=http://localhost:5001

# SOA Portal Scraper Tuning (optional)
# Overrides the browser User-Agent used when crawling the SOA portal.
# Leave unset to use the built-in default UA string.
# SOA_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36
# Pin DNS lookups for the portal host to a specific resolver behavior (0 = disabled).
SOA_PIN_DNS=0
# Hard deadline (in milliseconds) for a full portal crawl before aborting.
SOA_CRAWL_DEADLINE_MS=90000
# How long (in milliseconds) to wait for the portal's Cloudflare challenge to auto-clear
# before reporting BLOCKED_BY_SITE. Raise it if your server IP usually clears slowly.
# SOA_CHALLENGE_WAIT_MS=20000

# OpenRouter API Configuration
# OpenRouter provides access to multiple AI models through a single API
# Used for CAPTCHA solving and chatbot features
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_SITE_URL=http://localhost:5000
OPENROUTER_SITE_NAME=ITERasn hub
OPENROUTER_TIMEOUT_MS=20000

# Preferred OpenRouter free models for plain chat:
OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_CHAT_FALLBACK_MODELS=google/gemma-3-27b-it:free,arcee-ai/trinity-large-preview:free,google/gemma-3-12b-it:free,mistralai/mistral-small-3.1-24b-instruct:free,google/gemma-3-4b-it:free

# Preferred OpenRouter free models for image/CAPTCHA handling:
OPENROUTER_CAPTCHA_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_CAPTCHA_FALLBACK_MODELS=google/gemma-3-27b-it:free,mistralai/mistral-small-3.1-24b-instruct:free,google/gemma-3-12b-it:free,google/gemma-3-4b-it:free

# Google Vision API Key (for CAPTCHA solving in portal scraper - FALLBACK)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Used for primary OCR-based CAPTCHA text detection
GOOGLE_VISION_API_KEY=your-google-vision-api-key-here

# Google Gemini API Key (for AI chatbot and study assistance features - FALLBACK)
# Get your API key from: https://makersuite.google.com/app/apikey or https://aistudio.google.com/app/apikey
# This powers:
# - AI bot for answering student questions
# - Generating personalized study plans
# - Advanced CAPTCHA solving using Gemini Vision (multimodal AI)
# IMPORTANT: Replace this placeholder with your own valid Gemini API key
# See GEMINI_API_SETUP.md for detailed setup instructions
GEMINI_API_KEY=AIza-your-gemini-key-here

# Google Gemini Model (optional, defaults to gemini-1.5-flash)
# Available models: gemini-1.5-flash, gemini-1.5-pro, gemini-pro
# Note: gemini-1.5-flash is recommended for CAPTCHA solving (fast + vision capable)
GEMINI_MODEL=gemini-1.5-flash

# Google Drive Backup Configuration
# Folder ID for storing user backups as JSON files
# IMPORTANT: Set this to your own Google Drive folder ID for production
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id-here

# Number of timestamped backups to keep per user (default: 5)
BACKUP_RETENTION_COUNT=5

# Google Service Account (JSON string or path to file)
# For Google Sheets and Google Drive backup functionality
# GOOGLE_SERVICE_ACCOUNT={"type": "service_account", ...}
# GOOGLE_APPLICATION_CREDENTIALS=./server/googleServiceAccount.json

# Firebase Admin Configuration
# Use ONE of these approaches:
# 1. Put the full service account JSON into FIREBASE_SERVICE_ACCOUNT
# 2. Or provide the split variables below (useful on Render)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password-here
DB_NAME=iter_college_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
STORAGE_MODE=local

# CORS Configuration
CORS_WHITELIST=http://localhost:3000,http://localhost:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin Configuration
ADMIN_EMAIL=admin@iter.edu
ADMIN_PASSWORD=Admin@123456

# Socket.IO Configuration
SOCKET_CORS_ORIGIN=http://localhost:3000

# Backup Configuration
BACKUP_DIR=./backups

# Redis Configuration (Production Only)
# For production deployments, configure Redis for better caching performance
# In development, the system will automatically use in-memory cache (node-cache)
# REDIS_URL=redis://localhost:6379
# Or use individual settings:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=0
