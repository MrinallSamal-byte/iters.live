# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Feature Flags
# TEMPORARILY DISABLED — DO NOT REMOVE
# Portal features are disabled by default. Set to 'true' to enable.
PORTAL_FEATURES_ENABLED=false

# Flask Scraper Microservice Configuration
FLASK_SCRAPER_URL=http://localhost:5001

# OpenRouter API Configuration
# OpenRouter provides access to multiple AI models through a single API
# Used for CAPTCHA solving and chatbot features
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=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

# Models used for CAPTCHA solving (vision-capable models only):
# - amazon/nova-2-lite-v1:free
# - nvidia/nemotron-nano-12b-v2-vl:free

# Models used for chatbot features:
# - mistralai/mistral-small-3.1-24b-instruct:free
# - google/gemma-3-4b-it:free
# - google/gemma-3-12b-it:free
# - allenai/olmo-3-32b-think:free
# - openai/gpt-oss-120b:free
# - openai/gpt-oss-20b:free

# Google Vision API Key (for CAPTCHA solving in portal scraper - FALLBACK)
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Used for primary OCR-based CAPTCHA text detection
GOOGLE_VISION_API_KEY=AIzaSyB5aszVVX1UQuv0MEJOt0QumbnSa4x5z5A

# Google Gemini API Key (for AI chatbot and study assistance features - FALLBACK)
# Get your API key from: https://makersuite.google.com/app/apikey or https://aistudio.google.com/app/apikey
# This powers:
# - AI bot for answering student questions
# - Generating personalized study plans
# - Advanced CAPTCHA solving using Gemini Vision (multimodal AI)
# IMPORTANT: Replace this placeholder with your own valid Gemini API key
# See GEMINI_API_SETUP.md for detailed setup instructions
GEMINI_API_KEY=AIzaSyB5aszVVX1UQuv0MEJOt0QumbnSa4x5z5A

# Google Gemini Model (optional, defaults to gemini-1.5-flash)
# Available models: gemini-1.5-flash, gemini-1.5-pro, gemini-pro
# Note: gemini-1.5-flash is recommended for CAPTCHA solving (fast + vision capable)
GEMINI_MODEL=gemini-1.5-flash

# Google Drive Backup Configuration
# Folder ID for storing user backups as JSON files
# IMPORTANT: Set this to your own Google Drive folder ID for production
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id-here

# Number of timestamped backups to keep per user (default: 5)
BACKUP_RETENTION_COUNT=5

# Google Service Account (JSON string or path to file)
# For Google Sheets and Google Drive backup functionality
# GOOGLE_SERVICE_ACCOUNT={"type": "service_account", ...}
# GOOGLE_APPLICATION_CREDENTIALS=./server/googleServiceAccount.json

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password-here
DB_NAME=iter_college_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
STORAGE_MODE=local

# CORS Configuration
CORS_WHITELIST=http://localhost:3000,http://localhost:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin Configuration
ADMIN_EMAIL=admin@iter.edu
ADMIN_PASSWORD=Admin@123456

# Socket.IO Configuration
SOCKET_CORS_ORIGIN=http://localhost:3000

# Backup Configuration
BACKUP_DIR=./backups

# Redis Configuration (Production Only)
# For production deployments, configure Redis for better caching performance
# In development, the system will automatically use in-memory cache (node-cache)
# REDIS_URL=redis://localhost:6379
# Or use individual settings:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password
# REDIS_DB=0
